<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Wacht ntfy marker-watcher. 0.4.0 Teil C.
  Watches /Users/afschinmirhamed/Projects/aion-lumen/wacht-markers/ (a MOUNTED dir
  visible to the sandboxed Wacht task — the task's ~ is NOT the Mac home) and
  publishes each marker to the self-hosted ntfy `hermes-wacht` topic. Every 5 min.

  Install:
    cp release/0.4.0/ntfy/com.aionlumen.wacht-ntfy-watcher.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.aionlumen.wacht-ntfy-watcher.plist
  Reload after change:
    launchctl unload ~/Library/LaunchAgents/com.aionlumen.wacht-ntfy-watcher.plist
    cp ... ~/Library/LaunchAgents/ && launchctl load ...
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.aionlumen.wacht-ntfy-watcher</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/afschinmirhamed/Projects/life-mail/scripts/wacht_marker_watcher.py</string>
        <string>--markers-dir</string>
        <string>/Users/afschinmirhamed/Projects/aion-lumen/wacht-markers</string>
        <string>--archive-dir</string>
        <string>/Users/afschinmirhamed/.local/state/life/wacht-markers-done</string>
    </array>

    <key>StartInterval</key>
    <integer>300</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/afschinmirhamed/.local/state/life/wacht-watcher.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/afschinmirhamed/.local/state/life/wacht-watcher.err.log</string>

    <key>ThrottleInterval</key>
    <integer>10</integer>
</dict>
</plist>
