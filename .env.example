VAULT_PATH=/home/user/Projects/life
HERMES_API_URL=http://localhost:8642
HERMES_API_KEY=your-hermes-api-key
PORT=5173

# Folio import inbox (optional overrides)
# FOLIO_INBOX_PATH=~/.folio/inbox

# LLM triage agent (local LM Studio)
LM_STUDIO_BASE_URL=http://127.0.0.1:1234
FOLIO_AGENT_MODEL=qwen3-30b-a3b-thinking-2507
FOLIO_AGENT_CONFIDENCE=0.8
# Auto-commit: off by default. Enable only after a trust phase with error-free review practice.
FOLIO_AGENT_AUTO=0

# Explicit optional sources. Use absolute paths (no ~ expansion).
# FOLIO_CAREER_TRACKER_PATH=/absolute/path/positions-tracker.html
# FOLIO_MAIL_ACCOUNTS_PATH=/absolute/path/mail-accounts.json
# Identity aliases for calendar grouping and imported career evidence (optional).
# FOLIO_OWNER_ALIASES=Alex Beispiel
# FOLIO_CAREER_PERSON_KEY=career:person:owner
