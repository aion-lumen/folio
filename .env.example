VAULT_PATH=/home/user/Projects/life
HERMES_API_URL=http://localhost:8642
HERMES_API_KEY=your-hermes-api-key
PORT=5173

# Folio import inbox (optional overrides)
# FOLIO_INBOX_PATH=~/.folio/inbox

# LLM triage agent (local LM Studio)
LM_STUDIO_BASE_URL=http://127.0.0.1:1234
FOLIO_AGENT_MODEL=qwen3-30b-a3b-thinking-2507
FOLIO_AGENT_CONFIDENCE=0.8
# Auto-commit: off by default. Enable only after a trust phase with error-free review practice.
FOLIO_AGENT_AUTO=0

# Explicit optional sources. Use absolute paths (no ~ expansion).
# FOLIO_CAREER_TRACKER_PATH=/absolute/path/positions-tracker.html
# FOLIO_MAIL_ACCOUNTS_PATH=/absolute/path/mail-accounts.json
# Identity aliases for calendar grouping and imported career evidence (optional).
# FOLIO_OWNER_ALIASES=Alex Beispiel
# FOLIO_CAREER_PERSON_KEY=career:person:owner

# Optional Memory semantic retrieval. Off until evaluated on your own questions.
# Uses a separate CPU embedding service; no changes to the shared chat runtime.
FOLIO_MEMORY_SEMANTIC=0
# Exact local model IDs accepted in answer-level tests (comma-separated). Empty keeps companion lexical.
# FOLIO_MEMORY_SEMANTIC_ANSWER_MODELS=your-tested-local-model
# FOLIO_MEMORY_EMBEDDING_URL=http://127.0.0.1:1235/v1/embeddings
# FOLIO_MEMORY_EMBEDDING_MODEL=intfloat/multilingual-e5-small@614241f622f53c4eeff9890bdc4f31cfecc418b3/qint8
# FOLIO_MEMORY_EMBEDDING_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
# FOLIO_MEMORY_EMBEDDING_DIMENSIONS=384
# FOLIO_MEMORY_SEMANTIC_MIN_SIMILARITY=0.78
# FOLIO_MEMORY_SEMANTIC_MIN_MARGIN=0.05
# FOLIO_MEMORY_SEMANTIC_MAX_CANDIDATES=2

# Optional owner-only Sonar search (private executable wrapper, configured separately)
# FOLIO_SONAR_SEARCH_RUNNER=/absolute/path/to/sonar-search-wrapper
