<?xml version="1.0" encoding="UTF-8"?>
<!--
  Leuchtfeuer metrics pull (LOCAL Mac, launchd). Pulls the VPS aggregates into ~/.folio/metrics/
  once a day. Pull-only over SSH: the VPS never pushes into this machine.

  Setup:
    0. VPS side: a read-only pull user `leuchtfeuer-pull` with an authorized_keys forced command
       (rrsync -ro /var/lib/leuchtfeuer/metrics) — see ops/leuchtfeuer/README.md. The key on the VPS
       is restricted to read-only rsync of exactly that dir; the client therefore addresses the
       RESTRICTED ROOT as `:/` (NOT the absolute path — rrsync interprets the client path relative
       to its locked dir).
    1. Replace __VPS_HOST__ (e.g. 185.143.100.222), __HOME__ (your home dir; launchd does not
       expand ~), and __RSYNC__ (`command -v rsync`; rsync 3.x is required for the VPS rrsync
       wrapper). The key is a dedicated Mac pull key (~/.ssh/leuchtfeuer_pull).
    2. mkdir -p ~/.folio/cache && cp com.folio.leuchtfeuer-pull.plist ~/Library/LaunchAgents/
    3. launchctl load ~/Library/LaunchAgents/com.folio.leuchtfeuer-pull.plist
       (RunAtLoad triggers an immediate pull; check ~/.folio/cache/leuchtfeuer-pull.log)

  No --delete: local history is append-only (the card only reads the last 30 days anyway; the
  VPS may prune older files without affecting the local record).
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.folio.leuchtfeuer-pull</string>
	<key>ProgramArguments</key>
	<array>
		<string>__RSYNC__</string>
		<string>-az</string>
		<string>-e</string>
		<!-- dedicated read-only pull key; IdentitiesOnly avoids offering other keys -->
		<string>ssh -i __HOME__/.ssh/leuchtfeuer_pull -o IdentitiesOnly=yes -o BatchMode=yes -o ConnectTimeout=15</string>
		<!-- rrsync forced command locks the root → address it as ":/", not the absolute path -->
		<string>leuchtfeuer-pull@__VPS_HOST__:/</string>
		<string>__HOME__/.folio/metrics/</string>
	</array>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key><integer>7</integer>
		<key>Minute</key><integer>30</integer>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardOutPath</key>
	<string>__HOME__/.folio/cache/leuchtfeuer-pull.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/.folio/cache/leuchtfeuer-pull.log</string>
</dict>
</plist>
